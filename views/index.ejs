<div id="dtc"><%- logo %></div>
<%- include('partials/map') %>

<script>
  var dtc = document.getElementById('dtc');
  var mapEl = document.getElementById('map');
  mapEl.style.opacity = '0';
  setTimeout(function () {
    dtc.style.transition = mapEl.style.transition = 'opacity 0.8s ease-in-out';
    dtc.style.opacity = '0';
    mapEl.style.opacity = '1';
    setTimeout(function () { dtc.style.display = 'none'; }, 850);
  }, 3000);
</script>
